# BuildCore CBMS - Apache Shared Hosting (GoDaddy cPanel) Rewrite & Security Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block hidden files & sensitive configuration paths
  RewriteRule ^(\.env|storage|config|cron|vendor)/ - [F,L]
  RewriteRule ^\. - [F,L]

  # Route all /api/* requests to PHP REST Front Controller
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # Serve existing static assets (React dist bundle, PWA manifest, sw.js, icons)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA Fallback for React routes (/client-portal, /projects/*, etc.)
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
