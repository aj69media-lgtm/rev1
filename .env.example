# ==============================================================================
# BuildCore CBMS - Environment Configuration Template
# Copy to .env for local or self-hosted deployments. Never commit real secrets.
# ==============================================================================

# --- Runtime & Server ---
NODE_ENV=development
PORT=3000
APP_URL="http://localhost:3000"
APP_NAME="BuildCore CBMS"

# --- Security & Authentication ---
# Optional master admin passcode override (leave blank to use first-run claim flow)
ADMIN_PASSCODE=
# Session signing secret (auto-generated in-memory if omitted in dev)
SESSION_SECRET=
SESSION_TTL_HOURS=24
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Database (Local Node SQLite) ---
SQLITE_DB_PATH="./storage/cbms.db"

# --- Database (Shared Hosting cPanel / Self-Hosted MySQL or MariaDB) ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cbms_prod
DB_USERNAME=cbms_user
DB_PASSWORD=

# --- File Storage ---
STORAGE_DIR="./storage/uploads"
MAX_UPLOAD_MB=10

# --- Optional SMTP Email Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@buildcore-cbms.local"

# --- Optional Gemini AI Features (Server-Side Only) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
